# Read by scripts/install-on-ha.sh only; the integration itself reads no
# environment. Copy to .env and fill in.

# SSH target of the Home Assistant host, key-based login (the SSH add-on).
HA_SSH_TARGET=root@homeassistant.local
# Home Assistant's config directory on that host.
HA_CONFIG_DIR=/config

# Optional, read by scripts/check-login.py only, so it can be run without
# typing the login. Never committed (.env is git-ignored).
BRIGHT_EMAIL=you@example.com
BRIGHT_PASSWORD=CHANGE_ME
